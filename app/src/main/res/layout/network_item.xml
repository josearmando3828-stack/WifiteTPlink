<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TP-Link_Archer_C5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BSSID: 94:A6:7E:11:22:33"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txtChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CH: 6"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:layout_marginEnd="15dp"/>

            <TextView
                android:id="@+id/txtVulnerability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vulnerable: WPS Pixie-Dust"
                android:textColor="#FFCC00"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
